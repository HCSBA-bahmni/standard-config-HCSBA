  "fieldValidation": {
    "RUN": {
      "pattern": "^\\d{1,8}-[0-9Kk]$",
      "errorMessage": "Ingrese un RUN válido; puede escribirlo con o sin puntos."
    },
    "firstName": {
      "pattern": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ' \\-]+$",
      "errorMessage": "REGISTRATION_FIRST_NAME_VALIDATION"
    },
    "middleName": {
      "pattern": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ' \\-]+$",
      "errorMessage": "REGISTRATION_MIDDLE_NAME_VALIDATION"
    },
    "lastName": {
      "pattern": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ' \\-]+$",
      "errorMessage": "REGISTRATION_LAST_NAME_VALIDATION"
    },
    "familyName2": {
      "pattern": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ' \\-]+$",
      "errorMessage": "REGISTRATION_LAST_NAME_VALIDATION"
    },
    "email": {
      "pattern": "^(?=.{1,254}$)(([^<>()\\[\\]\\\\.,;:\\s@\"]+(\\.[^<>()\\[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,63})$",
      "errorMessage": "REGISTRATION_EMAIL_VALIDATION"
    },
    "phoneNumber": {
      "pattern": "^9[0-9]{8}$",
      "errorMessage": "REGISTRATION_PHONE_NUMBER_VALIDATION"
    },
    "alternatePhoneNumber": {
      "pattern": "^(?:9|[2-6])[0-9]{8}$",
      "errorMessage": "REGISTRATION_ALTERNATE_PHONE_NUMBER_VALIDATION"
    },
    "fixedPhoneNumber": {
      "pattern": "^[2-6][0-9]{8}$",
      "errorMessage": "REGISTRATION_FIXED_PHONE_NUMBER_VALIDATION"
    }
  },
  "extensionPoints": [
    {
      "id": "org.bahmni.registration.navigation",
