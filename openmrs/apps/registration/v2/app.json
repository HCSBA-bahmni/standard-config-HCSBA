        },
        {
          "field": "biologicalSex",
          "translationKey": "REGISTRATION_BIOLOGICAL_SEX",
          "required": true
        },
        {
          "field": "genderIdentity",
          "translationKey": "REGISTRATION_GENDER_IDENTITY",
          "required": true
        },
        {
          "field": "countryOfOrigin",
          "translationKey": "REGISTRATION_COUNTRY_OF_ORIGIN",
          "required": true
        },
        {
          "field": "basicHealthInsurance",
