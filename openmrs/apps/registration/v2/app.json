          "required": true
        }
      ]
    },
    "contactInformation": {
      "translationKey": "REGISTRATION_CONTACT_INFORMATION_TITLE",
      "attributes": [
        {
          "field": "phoneNumber",
          "translationKey": "REGISTRATION_MOBILE_PHONE_NUMBER",
