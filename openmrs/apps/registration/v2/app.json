        },
        {
          "field": "fixedPhoneNumber",
          "translationKey": "REGISTRATION_FIXED_PHONE_NUMBER"
        },
        {
          "field": "alternatePhoneNumber",
          "translationKey": "REGISTRATION_OTHER_PHONE_NUMBER"
        },
        {
          "field": "otherPhoneType",
          "translationKey": "REGISTRATION_OTHER_PHONE_TYPE"
        },
        {
